{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bomberman",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bomberman.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Bomberman (Debug)"
        },
        {
            "name": "Run Bomberman",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bomberman.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Bomberman"
        }
    ]
}